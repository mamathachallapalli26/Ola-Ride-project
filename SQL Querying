-- OLA RIDE BOOKING DATA CLEANING
-- MySQL 8.0

CREATE DATABASE IF NOT EXISTS ola_project;
USE ola_project;

-- STEP 1: Check original data
SELECT COUNT(*) AS total_records
FROM ola_raw;

-- STEP 2: Create separate cleaned table
CREATE TABLE ola_cleaned AS
SELECT * FROM ola_raw;

-- STEP 3: Convert literal null strings into SQL NULL
UPDATE ola_cleaned
SET
    Booking_ID = NULLIF(TRIM(Booking_ID), 'null'),
    Customer_ID = NULLIF(TRIM(Customer_ID), 'null'),
    Vehicle_Type = NULLIF(TRIM(Vehicle_Type), 'null'),
    Booking_Status = NULLIF(TRIM(Booking_Status), 'null'),
    Pickup_Location = NULLIF(TRIM(Pickup_Location), 'null'),
    Drop_Location = NULLIF(TRIM(Drop_Location), 'null'),
    Payment_Method = NULLIF(TRIM(Payment_Method), 'null'),
    Incomplete_Rides_Reason =
        NULLIF(TRIM(Incomplete_Rides_Reason), 'null');

-- STEP 4: Remove duplicate booking IDs
DELETE t1
FROM ola_cleaned t1
JOIN ola_cleaned t2
ON t1.Booking_ID = t2.Booking_ID
AND t1.Booking_ID IS NOT NULL
AND t1.Date > t2.Date;

-- STEP 5: Standardize vehicle names
UPDATE ola_cleaned
SET Vehicle_Type = 'E-Bike'
WHERE LOWER(Vehicle_Type) = 'ebike';

-- STEP 6: Remove unnecessary spaces
UPDATE ola_cleaned
SET
    Vehicle_Type = TRIM(Vehicle_Type),
    Booking_Status = TRIM(Booking_Status),
    Pickup_Location = TRIM(Pickup_Location),
    Drop_Location = TRIM(Drop_Location);

-- STEP 7: Check missing booking IDs
SELECT *
FROM ola_cleaned
WHERE Booking_ID IS NULL;

-- STEP 8: Check booking statuses
SELECT DISTINCT Booking_Status
FROM ola_cleaned;

-- STEP 9: Check vehicle types
SELECT DISTINCT Vehicle_Type
FROM ola_cleaned;

-- STEP 10: Final record count
SELECT COUNT(*) AS cleaned_records
FROM ola_cleaned;

-- STEP 11: Check duplicates again
SELECT Booking_ID, COUNT(*) AS duplicate_count
FROM ola_cleaned
GROUP BY Booking_ID
HAVING COUNT(*) > 1;

-- STEP 12: Final cleaned dataset
SELECT *
FROM ola_cleaned;
USE ola_analytics;

DROP TABLE IF EXISTS ola_cleaned;

CREATE TABLE ola_cleaned AS
WITH normalized AS (
    SELECT
        NULLIF(TRIM(`Date`), '') AS booking_date,
        NULLIF(TRIM(`Time`), '') AS booking_time,
        NULLIF(TRIM(`Booking_ID`), '') AS booking_id,
        NULLIF(TRIM(`Booking_Status`), '') AS booking_status,
        NULLIF(TRIM(`Customer_ID`), '') AS customer_id,
        NULLIF(TRIM(`Vehicle_Type`), '') AS vehicle_type,
        NULLIF(TRIM(`Pickup_Location`), '') AS pickup_location,
        NULLIF(TRIM(`Drop_Location`), '') AS drop_location,
        NULLIF(TRIM(`V_TAT`), '') AS v_tat,
        NULLIF(TRIM(`C_TAT`), '') AS c_tat,
        NULLIF(TRIM(`Canceled_Rides_by_Customer`), '') AS customer_cancel_reason,
        NULLIF(TRIM(`Canceled_Rides_by_Driver`), '') AS driver_cancel_reason,
        NULLIF(TRIM(`Incomplete_Rides`), '') AS incomplete_rides,
        NULLIF(TRIM(`Incomplete_Rides_Reason`), '') AS incomplete_reason,
        NULLIF(TRIM(`Booking_Value`), '') AS booking_value,
        NULLIF(TRIM(`Payment_Method`), '') AS payment_method,
        NULLIF(TRIM(`Ride_Distance`), '') AS ride_distance,
        NULLIF(TRIM(`Driver_Ratings`), '') AS driver_rating,
        NULLIF(TRIM(`Customer_Rating`), '') AS customer_rating,
        NULLIF(TRIM(`Vehicle Images`), '') AS vehicle_image
    FROM ola_raw
),
cleaned AS (
    SELECT
        NULLIF(booking_date, 'null') AS booking_date,
        NULLIF(booking_time, 'null') AS booking_time,
        NULLIF(booking_id, 'null') AS booking_id,
        COALESCE(NULLIF(booking_status, 'null'), 'Unknown') AS booking_status,
        NULLIF(customer_id, 'null') AS customer_id,
        CASE
            WHEN LOWER(NULLIF(vehicle_type, 'null')) = 'ebike'
                THEN 'E-Bike'
            ELSE COALESCE(NULLIF(vehicle_type, 'null'), 'Unknown')
        END AS vehicle_type,
        NULLIF(pickup_location, 'null') AS pickup_location,
        NULLIF(drop_location, 'null') AS drop_location,
        NULLIF(v_tat, 'null') AS v_tat,
        NULLIF(c_tat, 'null') AS c_tat,
        NULLIF(customer_cancel_reason, 'null') AS customer_cancel_reason,
        NULLIF(driver_cancel_reason, 'null') AS driver_cancel_reason,
        NULLIF(incomplete_rides, 'null') AS incomplete_rides,
        NULLIF(incomplete_reason, 'null') AS incomplete_reason,
        NULLIF(booking_value, 'null') AS booking_value,
        NULLIF(payment_method, 'null') AS payment_method,
        NULLIF(ride_distance, 'null') AS ride_distance,
        NULLIF(driver_rating, 'null') AS driver_rating,
        NULLIF(customer_rating, 'null') AS customer_rating,
        NULLIF(vehicle_image, 'null') AS vehicle_image
    FROM normalized
),
typed AS (
    SELECT
        CASE
            WHEN booking_date REGEXP '^[0-9]{4}-[0-9]{2}-[0-9]{2}'
                THEN DATE(booking_date)
            ELSE NULL
        END AS booking_date,
        booking_time,
        booking_id,
        booking_status,
        customer_id,
        vehicle_type,
        pickup_location,
        drop_location,
        CAST(v_tat AS DECIMAL(10,2)) AS v_tat,
        CAST(c_tat AS DECIMAL(10,2)) AS c_tat,
        customer_cancel_reason,
        driver_cancel_reason,
        incomplete_rides,
        incomplete_reason,
        CAST(booking_value AS DECIMAL(12,2)) AS booking_value,
        payment_method,
        CAST(ride_distance AS DECIMAL(10,2)) AS ride_distance,
        CAST(driver_rating AS DECIMAL(4,2)) AS driver_rating,
        CAST(customer_rating AS DECIMAL(4,2)) AS customer_rating,
        vehicle_image
    FROM cleaned
    WHERE booking_id IS NOT NULL
),
deduplicated AS (
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY booking_id
            ORDER BY booking_date DESC, booking_time DESC
        ) AS row_num
    FROM typed
)
SELECT
    booking_date,
    booking_time,
    booking_id,
    booking_status,
    customer_id,
    vehicle_type,
    pickup_location,
    drop_location,
    v_tat,
    c_tat,
    customer_cancel_reason,
    driver_cancel_reason,
    incomplete_rides,
    incomplete_reason,
    booking_value,
    payment_method,
    ride_distance,
    driver_rating,
    customer_rating,
    vehicle_image
FROM deduplicated
WHERE row_num = 1;

-- Check cleaned data
SELECT COUNT(*) AS cleaned_records
FROM ola_cleaned;

-- Check duplicates
SELECT booking_id, COUNT(*) AS total
FROM ola_cleaned
GROUP BY booking_id
HAVING COUNT(*) > 1;

-- Check missing booking IDs
SELECT COUNT(*) AS missing_booking_ids
FROM ola_cleaned
WHERE booking_id IS NULL;